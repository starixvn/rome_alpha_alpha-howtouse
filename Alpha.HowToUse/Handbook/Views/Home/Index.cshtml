@using Alpha.HowToUse.Handbook.ViewModels
@model HomeViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@LanguageResources.AngencyHandbook</title>
    <link type="text/css" rel="stylesheet" href="~/Handbook/Styles/bundles/common.css" />
    <link type="text/css" rel="stylesheet" href="~/Handbook/Styles/bundles/page-home.css" />
</head>
<body>
    <div class="container">
        <div class="left-container"></div> <!-- keep this this to prevent break layout -->
        <div class="center-container">
            <div class="docsearch">
                <h2 class="ttl-search">@LanguageResources.HomePage_Title</h2>
                <div class="search">
                    <input id="txt-search" type="text" name="name" value="" placeholder="@LanguageResources.Search" />
                    <div class="box-suggestion hidden">
                        <ul></ul>
                    </div>
                    <button class="btn-search hover">
                        <span class="icon-search"></span>
                    </button>
                </div>
            </div>

            <div class="main-article" id="main-article">
                <ul class="head-tab">
                    <li class="active">
                        <a href="#">@LanguageResources.Introduction</a>
                    </li>
                </ul>
                <p>
                    @Html.Raw(LanguageResources.HomePage_Content)
                </p>
            </div>
        </div>
        <div class="right-container">            
        </div>
        
    </div>
    @Html.Hidden("RootPath", Url.Content("~"))
    @Html.Hidden("NoRecords", LanguageResources.NoRecords)
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    <script src="~/Handbook/Scripts/bundles/home.js" type="text/javascript"></script>
</body>
</html>