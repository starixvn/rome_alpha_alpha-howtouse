@using Alpha.HowToUse.Handbook.Models
@using Alpha.HowToUse.Handbook.ViewModels
@model IndexViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@LanguageResources.AngencyHandbook</title>
    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @StaticResources.RenderStyles("~/Handbook/Styles/bundles/common")
    @StaticResources.RenderStyles("~/Handbook/Styles/bundles/page-default")
</head>
<body data-lang="@Model.LanguageKey">
    <header class="header">
        <h1 class="logo">
            <a target="main" href="@AppPathHelper.GetRelativePath("site-howtouse", "Home")" class="hover">
                <img src="~/Handbook/Styles/images/logo.svg" alt="@LanguageResources.Handbook" />
            </a>
        </h1>
        <div class="search">
            <input id="txt-search" type="text" name="name" value="" placeholder="@LanguageResources.Search" />
            <div class="box-suggestion hidden">
                <ul></ul>
            </div>
            <button class="btn-search hover">
                <span class="icon-search"></span>
            </button>
        </div>
    </header>

    <div id="page-popup" class="modal fade hidden" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog ex-modal" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="icon icon-close close" data-dismiss="modal" aria-label="@LanguageResources.close"><span aria-hidden="true"></span></button>
                    <h4 class="modal-title" id="result-detail-title"><span class="popup-title" id="popup-title"></span></h4>
                </div>
                <div class="modal-body">
                    <iframe frameborder="0" allowtransparency="true" marginheight="0" marginwidth="0" scrolling="auto"
                            id="popup-iframe"></iframe>
                </div>
            </div>
        </div>
    </div>

    <main class="main-content">
        <div class="aside">
            <div class="menu">
                @Html.Partial("~/Handbook/Views/Default/BriefProfile.cshtml", Model.BriefProfile)

                <ul class="list-menu">
                    <li class="item-menu">
                        <a target="main" href="@AppPathHelper.GetRelativePath("site-howtouse", "Home")">
                            <span class="icon-home"></span>
                            @LanguageResources.Home
                        </a>
                    </li>
                    <li class="item-menu">
                        <a target="main" href="@AppPathHelper.GetRelativePath("site-howtouse", "Glossary")">
                            <span class="icon-glossary"></span>
                            @LanguageResources.Glossary
                        </a>
                    </li>
                </ul>
                <div class="language language-container">
                    <span class="spn-lang">@Model.LanguageName</span>
                    <span class="icon-right"></span>
                    <ul class="dropdown-language">
                        <li><a data-val="e" href="#">English</a></li>
                        <li><a data-val="ct" href="#">繁體中文</a></li>
                        <li><a data-val="cs" href="#">简体中文</a></li>
                        <li><a data-val="j" href="#">Japanese</a></li>
                        <li><a data-val="th" href="#">ภาษาไทย</a></li>
                        <li><a data-val="ko" href="#">Korean</a></li>
                        @if (Model.SupportVietnamese)
                        {
                            <li><a data-val="vi" href="#">Tiếng Việt</a></li>
                        }
                    </ul>
                </div>
            </div>

            <div class="category">
                <h2 class="title-category">@LanguageResources.AllCategories</h2>
                <ul class="list-item-cat">
                    @foreach (var c in Model.Categories)
                    {
                        @RenderCategory(c)
                    }
                </ul>
            </div>
        </div>
        <iframe id="ifr-main" name="main" src="@AppPathHelper.GetRelativePath("site-howtouse", "Home/Blank")"></iframe>

    </main>

    <div class="div-feedback @Model.LanguageCode hidden" id="feedback-function">
        <div class="feedback-box">
            <div class="icon-feedback"></div>
            <div class="txt-feedback"></div>
        </div>
        <div class="icon-close-feedback" title="@LanguageResources.close"></div>
    </div>

    @Html.Hidden("OnUserId", Model.OnUserId)
    @Html.Hidden("CustId", Model.CustId)
    @Html.Hidden("SubAccId", Model.SubAccId)
    @Html.Hidden("UserId", Model.UserId)
    @Html.Hidden("OldMainRootPath", Model.OldMainRootPath)
    @Html.Hidden("MessageRootPath", Model.MessageRootPath)
    @Html.Hidden("RootPath", AppPathHelper.GetRelativePath("site-howtouse", "./"))
    @Html.Hidden("NoRecords", LanguageResources.NoRecords)
    @Html.Hidden("SetCurrentURL", 1)
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-handbook/common")
    @StaticResources.RenderScripts("~/Handbook/Scripts/bundles/default")
</body>
</html>

@helper RenderCategory(CategoryModel category)
{
    if (category.Categories == null || !category.Categories.Any())
    {
        var articles = category.Articles ?? new List<ArticleModel>();

        <li>
            <div class="item-cat">
                <span class="icon-right"></span>
                <a class="text" target="main" href="@category.GetUrl()">
                    <span class="icon-folder"></span>@category.ShortName
                </a>
                <span class="count">@articles.Count()</span>
            </div>

            <ul class="list-item-article">
                @foreach (var a in articles)
                {
                    @RenderAticle(a)
                }
            </ul>
        </li>

        return;
    }

    <li>
        <div class="item-cat">
            <span class="icon-right"></span>
            <a class="text" target="main" href="@category.GetUrl()">
                <span class="icon-folder"></span>@category.ShortName
            </a>
            <span class="count">@category.Categories.Count()</span>
        </div>
        <ul class="list-item-cat">
            @foreach (var c in category.Categories)
            {
                @RenderCategory(c)
            }
        </ul>
    </li>
}

@helper RenderAticle(ArticleModel a)
{
    <li>
        <div class="item-cat">
            <a class="text item-slug" target="@a.GetTargetFrame()" href="@a.GetUrl()">
                <span class="icon-article">
                </span>@a.Title
            </a>
        </div>
    </li>
}