@using Alpha.HowToUse.Handbook.Models
@using Alpha.HowToUse.Handbook.ViewModels
@model IndexViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@LanguageResources.AngencyHandbook</title>
    <link type="text/css" rel="stylesheet" href="~/Handbook/Styles/bundles/common.css" />
</head>
<body data-lang="@Model.Language">
    <header class="header">
        <h1 class="logo">
            <a target="main" href="~/Home" class="hover">
                <img src="~/Handbook/Styles/images/logo.svg" alt="@LanguageResources.Handbook" />
            </a>
        </h1>
        <div class="search">
            <input id="txt-search" type="text" name="name" value="" placeholder="@LanguageResources.Search" />
            <div class="box-suggestion hidden">
                <ul></ul>
            </div>
            <button class="btn-search hover">
                <span class="icon-search"></span>
            </button>
        </div>
    </header>

    <main class="main-content">
        <div class="aside">
            <div class="menu">
                @Html.Partial("~/Handbook/Views/Default/BriefProfile.cshtml", Model.BriefProfile)

                <ul class="list-menu">
                    <li class="item-menu">
                        <a target="main" href="~/Home">
                            <span class="icon-home"></span>
                            @LanguageResources.Home
                        </a>
                    </li>
                    <li class="item-menu">
                        <a target="main" href="~/Glossary">
                            <span class="icon-glossary"></span>
                            @LanguageResources.Glossary
                        </a>
                    </li>
                </ul>
                <div class="language language-container">
                    <span class="spn-lang">@Model.LanguageName</span>
                    <span class="icon-right"></span>
                    <ul class="dropdown-language">
                        <li><a data-val="e" href="#">English</a></li>
                        <li><a data-val="ct" href="#">繁體中文</a></li>
                        <li><a data-val="cs" href="#">简体中文</a></li>
                        <li><a data-val="j" href="#">Japanese</a></li>
                        <li><a data-val="th" href="#">ภาษาไทย</a></li>
                        <li><a data-val="ko" href="#">Korean</a></li>
                        @if (Model.SupportVietnamese)
                        {
                            <li><a data-val="vi" href="#">Tiếng Việt</a></li>
                        }
                    </ul>
                </div>
            </div>

            <div class="category">
                <h2 class="title-category">@LanguageResources.AllCategories</h2>
                <ul class="list-item-cat">
                    @foreach (var c in Model.Categories)
                    {
                        @RenderCategory(c)
                    }
                </ul>
            </div>
        </div>
        <iframe id="ifr-main" name="main" src="~/Home/Blank"></iframe>

    </main>

    @Html.Hidden("OnUserId", Model.OnUserId)
    @Html.Hidden("OldMainRootPath", Model.OldMainRootPath)
    @Html.Hidden("RootPath", Url.Content("~"))
    @Html.Hidden("NoRecords", LanguageResources.NoRecords)
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-handbook/common")
    <script src="~/Handbook/Scripts/bundles/default.js" type="text/javascript"></script>
</body>
</html>

@helper RenderCategory(CategoryModel category)
{
    if (category.Categories == null || !category.Categories.Any())
    {
        var articles = category.Articles ?? new List<ArticleModel>();

        <li>
            <div class="item-cat">
                <span class="icon-right"></span>
                <a class="text" target="main" href="~/Category/GetBySlug?slug=@category.Slug">
                    <span class="icon-folder"></span>@category.ShortName
                </a>
                <span class="count">@articles.Count()</span>
            </div>

            <ul class="list-item-article">
                @foreach (var a in articles)
                {
                    @RenderAticle(a)
                }
            </ul>
        </li>

        return;
    }

    <li>
        <div class="item-cat">
            <span class="icon-right"></span>
            <a class="text" target="main" href="~/Category/GetBySlug?slug=@category.Slug">
                <span class="icon-folder"></span>@category.ShortName
            </a>
            <span class="count">@category.Categories.Count()</span>
        </div>
        <ul class="list-item-cat">
            @foreach (var c in category.Categories)
            {
                @RenderCategory(c)
            }
        </ul>
    </li>
}

@helper RenderAticle(ArticleModel a)
{
    <li>
        <div class="item-cat">
            <a class="text" target="main" href="~/Article/GetBySlug?slug=@a.Slug">
                <span class="icon-article"></span>@a.Title
            </a>
        </div>
    </li>
}