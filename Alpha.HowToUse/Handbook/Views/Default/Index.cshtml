                                    <span class="icon-right"></span>
                                    <a class="text" href="#"><span class="icon-folder"></span>Action Log</a>
                                </div>
                                <ul class="list-item-article">
                                    <li>
                                        <div class="item-cat">
                                            <a class="text" href="#"><span class="icon-article"></span>Action Log</a>
                                            <span class="icon-bookmark"></span>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="item-cat">
                                            <a class="text" href="#">
                                                <span class="icon-article"></span>
                                                Action Log - Mobile

                                            </a>
                                            <span class="icon-bookmark"></span>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="item-cat">
                                            <a class="text" href="#"><span class="icon-article"></span>Action Log - Classic</a>
                                        </div>
                                    </li>
                                </ul>
                            </li>
                            <li>
                                <div class="item-cat">
                                    <span class="icon-right"></span>
                                    <a class="text" href="#"><span class="icon-folder"></span>Other</a>
                                </div>
                            </li>
                        </ul>
                    </li>
                    <li>
                        <div class="item-cat">
                            <span class="icon-right"></span>
                            <a class="text" href="#"><span class="icon-folder"></span>Risk Management</a>
