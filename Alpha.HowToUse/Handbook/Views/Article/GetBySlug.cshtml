@using Alpha.HowToUse.Handbook.ViewModels;

@{
    Layout = null;
    var article = Model.Article ?? new Alpha.HowToUse.Handbook.Models.ArticleModel();
    var parentCategory = Model != null && article.Categories != null && article.Categories.Any() ? article.Categories.First() : null;
}
@model ArticleViewModel

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@LanguageResources.AngencyHandbook</title>
    @StaticResources.RenderStyles("~/Handbook/Styles/bundles/common")
    @StaticResources.RenderStyles("~/Handbook/Styles/bundles/articles/get-by-slug")
</head>
<body class="@Model.Language">
    <div class="container">
        <div class="left-container"></div> <!-- keep this this to prevent break layout -->
        <div class="center-container">
            @if (Model == null || string.IsNullOrWhiteSpace(article.Slug))
            {
                @LanguageResources.NoRecords
            }
            else
            {
                <div class="main-article" id="main-article">
                    <div class="detail-article" id="detail-article">
                        <h2 class="title-page">@article.Title</h2>
                        <div class="top-info">
                            <div class="item-info">
                                <span class="icon-calendar"></span>
                                @LanguageResources.PublishedOn @article.PublishedAtStr
                            </div>
                            <div class="item-info item-info-folder">
                                <a @(parentCategory == null ? "" : "href=" + parentCategory.GetUrl("../") + "")>
                                    <span class="icon-folder"></span>
                                    @(parentCategory == null ? string.Empty : parentCategory.ShortName)
                                </a>
                            </div>
                        </div>
                        <div class="article-content">
                            @Html.Raw(article.Content)
                        </div>

                    </div>
                </div>
            }
        </div>
        <div class="right-container">
            <div class="inner">
                @if (Model != null && !string.IsNullOrWhiteSpace(article.Slug))
                {
                    <h2 class="title-category">@LanguageResources.Contents</h2>
                }
                <div id="float-content">
                </div>
            </div>
        </div>
    </div>
    <a class="icon-back-to-top" href="#" id="back-to-top"></a>
    <div class="zoomed-img-container hidden"></div>
    @Html.Hidden("RootPath", AppPathHelper.GetRelativePath("site-howtouse", "../"))
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.RenderScripts("~/Handbook/Scripts/bundles/articles/get-by-slug")
</body>
</html>