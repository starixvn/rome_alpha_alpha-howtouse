@using Alpha.HowToUse.Handbook.Models;

@{
    Layout = null;
}
@model ArticleModel

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@LanguageResources.AngencyHandbook</title>
    <link type="text/css" rel="stylesheet" href="~/Handbook/Styles/bundles/site-handbook/common.css" />
</head>
<body>
    <div class="main-article" id="main-article">
        <div class="detail-article" id="detail-article">
            <h2 class="title-page">@Model.Title</h2>
            <div class="top-info">
                <div class="item-info">
                    <span class="icon-calendar"></span>
                    @Model.PublishedAtStr
                </div>
                <div class="item-info item-info-folder">
                    <span class="icon-folder"></span>
                    @Model.Title
                </div>
            </div>
            @Html.Raw(Model.Content)
        </div>
    </div>
</body>
</html>