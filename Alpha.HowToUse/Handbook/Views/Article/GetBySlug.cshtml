@using Alpha.HowToUse.Handbook.Models;

@{
    Layout = null;
}
@model ArticleModel

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@LanguageResources.AngencyHandbook</title>
    <link type="text/css" rel="stylesheet" href="~/Handbook/Styles/bundles/common.css" />
    <link type="text/css" rel="stylesheet" href="~/Handbook/Styles/bundles/articles/get-by-slug.css" />
</head>
<body>
    <div class="container">
        <div class="left-container"></div> <!-- keep this this to prevent break layout -->
        <div class="center-container">
            @if (Model == null || string.IsNullOrWhiteSpace(Model.Slug))
            {
                @LanguageResources.NoRecords
            }
            else
            {
                <div class="main-article" id="main-article">
                    <div class="detail-article" id="detail-article">
                        <h2 class="title-page">@Model.Title</h2>
                        <div class="top-info">
                            <div class="item-info">
                                <span class="icon-calendar"></span>
                                @LanguageResources.PublishedOn @Model.PublishedAtStr
                            </div>
                            <div class="item-info item-info-folder">
                                <a href="@Url.Content("~/Category/GetBySlug?slug=" + Model.Categories.First().Slug)">
                                    <span class="icon-folder"></span>
                                    @Model.Categories.First().ShortName
                                </a>
                            </div>
                        </div>
                        <div class="article-content">
                            @Html.Raw(Model.Content)
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="right-container">
            <div class="inner">
                <h2 class="title-category">Contents</h2>
                <ul class="list-content">
                    <li><a href="#">1. Action Type</a></li>
                    <li>
                        <a class="active" href="#">2. Filter</a>
                        <ul>
                            <li><a href="#">a. Member Username</a></li>
                            <li><a href="#">b. Date Range</a></li>
                            <li><a href="#">c. Created By</a></li>
                        </ul>
                    </li>
                    <li><a class="active" href="#">3. Columns Definition - What do the columns mean?</a></li>
                    <li><a href="#"></a></li>
                    <li><a href="#"></a></li>
                </ul>
                <div id="list-anchor"></div>
            </div>
        </div>
    </div>

    @Html.Hidden("RootPath", Url.Content("~"))
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    <script src="~/Handbook/Scripts/bundles/articles/get-by-slug.js" type="text/javascript"></script>
</body>
</html>