@using Alpha.HowToUse.Handbook.ViewModels;

@{
    Layout = null;
}
@model SearchArticleViewModel

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@LanguageResources.AngencyHandbook</title>
    @StaticResources.RenderStyles("~/Handbook/Styles/bundles/common")
</head>
<body>
    <div class="container">
        <div class="left-container"></div> <!-- keep this this to prevent break layout -->
        <div class="center-container">
            <h2 class="title-page">@LanguageResources.Search</h2>

            <div class="main-article" id="main-article">
                @if (Model.Articles == null || !Model.Articles.Any())
                {
                    @LanguageResources.NoRecords
                }
                else
                {
                    <div class="block-item">
                        @foreach (var a in Model.Articles)
                        {
                            <div class="item-article">
                                <div class="info-article">
                                    <div class="left-title">
                                        <a href="~/Article/GetBySlug?slug=@a.Slug">
                                            <span class="icon-article"></span>
                                            @a.Title
                                        </a>
                                    </div>
                                    <div class="right-info">
                                        <div class="item-info">
                                            <span class="icon-calendar"></span>
                                            @LanguageResources.PublishedOn @a.PublishedAtStr
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    @Html.Raw(a.Summary)
                                </div>
                                <a href="~/Article/GetBySlug?slug=@a.Slug" class="read-more">@LanguageResources.ReadMore</a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="right-container"></div>
    </div>
</body>
</html>