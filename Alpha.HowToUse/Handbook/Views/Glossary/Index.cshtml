@using Alpha.HowToUse.Handbook.Models;
@using Alpha.HowToUse.Handbook.ViewModels;
@model GlossaryViewModel
@{
    Layout = null;
    char[] alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZ#".ToCharArray();
    var glossaries = Model.Glossaries ?? new List<GlossaryModel>();
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@LanguageResources.AngencyHandbook</title>
    <link type="text/css" rel="stylesheet" href="~/Handbook/Styles/bundles/common.css" />
</head>
<body>
    <div class="container">
        <div class="left-container"></div> <!-- keep this this to prevent break layout -->
        <div class="center-container">
            <h2 class="title-page">@LanguageResources.Glossary</h2>
            <div class="list-glossary">
                <a data-val="" @(string.IsNullOrWhiteSpace(Model.Group) ? "class=active" : "") href="#">All</a>
                @foreach (var a in alpha)
                {
                    <a data-val="@a" @(string.Equals(Model.Group, a.ToString()) ? "class=active" : "") href="#">@a</a>
                }
            </div>
            <div class="list-group-glossary">

                @foreach (var a in alpha)
                {
                    <div class="characters">@(a).</div>
                    var gs = glossaries.Where(g => g.Title.ToLowerInvariant().StartsWith(a.ToString().ToLowerInvariant()));

                    if (gs.Any())
                    {
                        foreach (var g in gs)
                        {

                            <div class="group-glossary">
                                <div class="group-glossary-title">
                                    @g.Name
                                </div>
                                <div>
                                    @Html.Raw(g.Content)
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p>@LanguageResources.NoRecords</p>
                    }
                }

            </div>

        <div class="right-container"></div>
    </div>


    @Html.Hidden("RootPath", Url.Content("~"))
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    <script src="~/Handbook/Scripts/bundles/glossary.js" type="text/javascript"></script>
</body>
</html>