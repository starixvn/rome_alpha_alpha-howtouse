@using Alpha.HowToUse.Handbook.ViewModels;
@model CategoryViewModel


@{
    Layout = null;
    var category = Model.Category ?? new Alpha.HowToUse.Handbook.Models.CategoryModel();
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@LanguageResources.AngencyHandbook</title>
    @StaticResources.RenderStyles("~/Handbook/Styles/bundles/common")
</head>
<body>
    <div class="container">
        <div class="left-container"></div> <!-- keep this this to prevent break layout -->
        <div class="center-container">
            <div class="block-item">
                @foreach (var c in category.Categories)
                {

                    <a href="@Url.Content("~/Category/GetBySlug?slug=" + c.Slug)" class="item-folder">
                        <span class="icon-folder-open"></span>
                        <span class="title-cat">@c.Name</span>
                    </a>
                }
            </div>
            <div class="block-item">
                @foreach (var a in category.Articles)
                {
                    <a href="@Url.Content("~/Article/GetBySlug?slug=" + a.Slug)" class="item-article-short">
                        <span class="icon-article"></span>
                        <span class="info">
                            <span class="title">@a.Title</span>
                            <span class="time">@LanguageResources.PublishedOn @a.PublishedAtStr</span>
                        </span>
                    </a>
                }
            </div>
        </div>
        <div class="right-container"></div>
    </div>

</body>
</html>