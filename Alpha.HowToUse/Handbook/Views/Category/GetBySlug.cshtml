@using Alpha.HowToUse.Handbook.Models;

@{
    Layout = null;
}
@model CategoryModel

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@LanguageResources.AngencyHandbook</title>
    <link type="text/css" rel="stylesheet" href="~/Handbook/Styles/bundles/site-handbook/common.css" />
</head>
<body>
    <div class="block-item">
        @foreach (var c in Model.Categories)
        {

            <a href="#" class="item-folder">
                <span class="icon-folder-open"></span>
                <span class="title-cat">@c.Name</span>
            </a>
        }
    </div>
    <div class="block-item">
        @foreach (var a in Model.Articles)
        {
            <a href="#" class="item-article-short">
                <span class="icon-article"></span>
                <span class="info">
                    <span class="title">@a.Title</span>
                    <span class="time">Published on Mon, Feb 7, 2022</span>
                </span>
            </a>

        }
    </div>
</body>
</html>