<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="SecurityCodeSection" type="Fanex.Razorbill.Security.Configurations.SecurityCodeSection, Fanex.Razorbill.Security" />
    <section name="Alpha.NetThrottling" type="Alpha.NetThrottling.NetThrottlingConfiguration, Alpha.NetThrottling" />
    <section name="Alpha.NetThrottling.Whitelist" type="Alpha.NetThrottling.WhitelistConfiguration, Alpha.NetThrottling" />
  </configSections>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="ShowViewLog" value="1"/>
    <add key="DisabledAutoMaster" value="0"/>
    <add key="StoredProcedurePath" value="~/Handbook/App_Data/SPNames/LOCAL" />
    <add key="ContentAPI:Environment" value="PROD" />
    <add key="ContentAPIUrl" value="https://alpha-content.nexdev.net" />
    <add key="ContentAPIToken" value="6b5d3280cb588538ca3ed81d5b7d0ecb4793abbcfbf8327ba0da6ad8f651a79a9eb55f2d048d20e19fc54e9166531ce46c7361de942030d8b8fd6ff435a830b653e0f1d386ada060f5cb93fe271e56b9ed0d8e7701e2080ffc876c90029293c74dc76c7eb3d23d554e0ee60172a8ef5141b154c32df91e3b7b9f46f88e53bda1" />
    <add key="RedisConfigurationOptions:Alpha.NetThrottling" value="ha.nexdev.net:16389,Password=foo1@bared,Name=Alpha.NetThrottling.LOCAL,abortConnect=false,configChannel=__Booksleeve_MasterChanged" />
  </appSettings>

  <SecurityCodeSection configSource="SecurityCode.config" />
  <Alpha.NetThrottling resolver="Alpha.NetThrottling.Mvc.Resolvers.DefaultResolver, Alpha.NetThrottling.MVC" redisConfigurationOptionsKey="RedisConfigurationOptions:Alpha.NetThrottling">
    <keys>
      <remove name="Any" />
      <add name="Any" path="*" method="*" maxRequests="5" throttleDuration="30" blockDuration="30" filter="Alpha.NetThrottling.Filters.WhitelistSessionFilter, Alpha.NetThrottling" />
    </keys>
  </Alpha.NetThrottling>
  <Alpha.NetThrottling.Whitelist custIds="17996464,21984259,20269385,15323100,14771858,24338704,19000014,19562449,19562472,27973467,26912753,14521687,39061067,27783723,26369026,4664545" />
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
  </startup>
  <system.web>
    <compilation targetFramework="4.0" debug="true"/>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <modules/>
  </system.webServer>
</configuration>